# Copy to deploy/.env on the host, chmod 600. NEVER commit the real file:
# this repository is PUBLIC.
#
# BasicAuth users for the private /k knowledge page, htpasswd format:
#   htpasswd -nb andre '<password>'
# Escape every $ as $$ here. Compose DOES interpolate the value of a variable
# after substituting it, so a single $ makes it read $apr1 as an (empty)
# variable and silently produces a BROKEN hash — verified the hard way on
# 2026-08-31. Compare against the running container before trusting a change:
#   docker inspect amiticia-site-amiticia-1 --format \
#     '{{index .Config.Labels "traefik.http.middlewares.amiticia-k-auth.basicauth.users"}}'
AMITICIA_K_BASICAUTH=
