# Copy to deploy/.env on the host, chmod 600. NEVER commit the real file:
# this repository is PUBLIC.
#
# BasicAuth users for the private /k knowledge page, htpasswd format:
#   htpasswd -nb andre '<password>'
# Use a single $ here — this file is read by compose as literal values, so the
# $$ escaping used inside a compose label does NOT apply.
AMITICIA_K_BASICAUTH=
